# =============================================================================
# Rashidiya Palace Restaurant — environment template
# =============================================================================
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored and
# must never be committed. Placeholders only in this file.
# =============================================================================

# Public site URL, used for canonical tags, the sitemap and Open Graph images.
# No trailing slash. Safe to expose — it is only the public address.
NEXT_PUBLIC_SITE_URL=https://your-domain.ae

# -----------------------------------------------------------------------------
# Enquiry delivery (server-only — never prefix this with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# Where the contact form sends table requests. Point it at a mail service
# (Resend, Postmark), an automation hook (Zapier, Make) or a WhatsApp Business
# webhook. The endpoint receives a JSON POST:
#   { name, phone, guests, when, message, receivedAt }
#
# While this is unset, the form validates normally but reports honestly that
# enquiries are not connected and directs the visitor to phone the restaurant.
ENQUIRY_WEBHOOK_URL=
